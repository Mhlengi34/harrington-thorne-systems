# Copy this file to .env and fill in your values.

# Password for the dashboard (username is "admin"). Required.
ADMIN_PASSWORD=change-me

PORT=3000

# Public HTTPS address of this app, used for Twilio webhooks
# (e.g. https://reengage.example.com or an ngrok URL while testing).
PUBLIC_URL=

# Twilio credentials — leave blank to run in dry-run mode (nothing is sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your WhatsApp-enabled sender number, e.g. +27821234567
# (for the Twilio sandbox use +14155238886).
TWILIO_WHATSAPP_FROM=

# Country code applied to local numbers like 082 123 4567.
DEFAULT_COUNTRY_CODE=27

# Delay between messages in milliseconds (keeps you within WhatsApp limits).
SEND_DELAY_MS=1000

# Where the SQLite database is stored.
DATABASE_PATH=./data/reengage.db
